class Solution {
public:
    bool canPartition(vector<int>& nums) {
        int total = 0;
        for (int num : nums) {
            total += num;
        }
        if (total % 2 != 0) return false;
        unordered_set<int> sums;
        sums.insert(0);

        for (int num : nums) {
            unordered_set<int> next = sums;

            for (int s : sums) {
                int newSum = s + num;
                if (newSum == total) return true;
                if (newSum < total) {
                    next.insert(newSum);
                }
            }

            sums = next;
        }

        return sums.count(total);
    }
};
